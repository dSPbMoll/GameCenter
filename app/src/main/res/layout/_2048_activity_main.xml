<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#F7FFA3"
    tools:context="._2048._2048Activity">

    <!-- Top Info Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="15dp" >

        <!-- Game Title -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="115dp"
            android:layout_height="115dp"
            android:background="#FFF13B"
            android:gravity="center"
            android:text="@string/_2048"
            android:textSize="40sp" />

                <!-- Current Score View -->
        <!-- Best Score View -->

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="#171717"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/textView"
            app:layout_constraintEnd_toStartOf="@+id/linearLayout2">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#171717"
                android:gravity="center"
                android:text="@string/score"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/score_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_0"
                android:textColor="@color/white"
                android:textSize="20sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#171717"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@+id/linearLayout"
            app:layout_constraintEnd_toEndOf="parent" >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/best"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/best_score_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/_0"
                android:textColor="@color/white"
                android:textSize="20sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/step_back_btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#8F7A66"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/_2048_all_ic_back"

            app:layout_constraintTop_toBottomOf="@+id/linearLayout"
            app:layout_constraintStart_toStartOf="@+id/linearLayout"
            app:layout_constraintEnd_toStartOf="@+id/restart_btn" />

        <ImageButton
            android:id="@+id/restart_btn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#8F7A66"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/_2048_all_ic_restart"

            app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
            app:layout_constraintStart_toEndOf="@+id/step_back_btn"
            app:layout_constraintEnd_toEndOf="@+id/linearLayout2" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ////////////////// START OF THE GAME GRID ////////////////// -->

    <com.example.gamecenter._2048.GameGrid
        android:id="@+id/game_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="15dp"
        android:background="#F7FFA3">

        <!-- Background Layer -->
        <com.example.gamecenter._2048.GGBackgroundLayer
            android:id="@+id/game_grid_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:alignmentMode="alignMargins"
            android:background="#999999"
            android:columnCount="4"
            android:padding="5dp"
            android:rowCount="4"
            android:useDefaultMargins="true"
            android:elevation="0dp"/>

        <!-- Numbers Layer -->
        <com.example.gamecenter._2048.GGNumberLayer
            android:id="@+id/game_grid_numbers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="#00000000"
            android:elevation="1dp"/>

        <!-- Animations Layer -->
        <com.example.gamecenter._2048.GGAnimationLayer
            android:id="@+id/game_grid_animations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="#00000000"
            android:elevation="2dp"/>

    </com.example.gamecenter._2048.GameGrid>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="50dp"
        android:gravity="center"
        android:text="00:00"
        android:background="@color/white"
        android:padding="5dp"/>


</LinearLayout>