<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dungeonScene"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/jd2_dungeon_scene"
    tools:context=".juice_dungeon_2.DungeonActivity">

    <!-- Current Shift Available Moves -->
    <LinearLayout
        android:id="@+id/teamMovesLL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/moveStrike"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_margin="5dp"
            android:src="@drawable/jd2_dungeon_ic_strike" />

    </LinearLayout>

    <!-- Floor Info -->

    <!-- Enemy LL -->

    <!-- Team members -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:text="@string/floor"
        android:textColor="@color/white"
        android:textSize="25sp"
        app:layout_constraintEnd_toStartOf="@+id/floorNumberTV"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/floorNumberTV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="0"
        android:textColor="@color/white"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/enemyLL"
        android:layout_width="200dp"
        android:layout_height="230dp"
        android:gravity="center"

        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.499"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.745">

        <TextView
            android:id="@+id/enemyHP"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="0/0"
            android:textColor="@color/green"
            android:textSize="@dimen/characterHP" />

        <ImageView
            android:id="@+id/enemyImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/jd2_all_goblin" />


    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="120dp"
        android:layout_height="250dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/enemyLL"
        app:layout_constraintHorizontal_bias="0.526"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.813">

        <LinearLayout
            android:id="@+id/team1LL"
            android:layout_width="80dp"
            android:layout_height="95dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/team1HP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="100/100"
                android:textColor="@color/green"
                android:textSize="@dimen/characterHP" />

            <ImageView
                android:id="@+id/team1Image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/jd2_all_macia" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/team2LL"
            android:layout_width="80dp"
            android:layout_height="95dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/team2HP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="200/200"
                android:textColor="@color/green"
                android:textSize="@dimen/characterHP" />

            <ImageView
                android:id="@+id/team2Image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/jd2_all_macia" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/team3LL"
            android:layout_width="80dp"
            android:layout_height="95dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/team3HP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="300/300"
                android:textColor="@color/green"
                android:textSize="@dimen/characterHP" />

            <ImageView
                android:id="@+id/team3Image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/jd2_all_macia" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="120dp"
        android:layout_height="250dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toEndOf="@+id/enemyLL"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.813">

        <LinearLayout
            android:id="@+id/team4LL"
            android:layout_width="80dp"
            android:layout_height="95dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/team4HP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="400/400"
                android:textColor="@color/green"
                android:textSize="@dimen/characterHP" />

            <ImageView
                android:id="@+id/team4Image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/jd2_all_macia" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/team5LL"
            android:layout_width="80dp"
            android:layout_height="95dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/team5HP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="500/500"
                android:textColor="@color/green"
                android:textSize="@dimen/characterHP" />

            <ImageView
                android:id="@+id/team5Image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/jd2_all_macia" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/team6LL"
            android:layout_width="80dp"
            android:layout_height="95dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/team6HP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="600/600"
                android:textColor="@color/green"
                android:textSize="@dimen/characterHP" />

            <ImageView
                android:id="@+id/team6Image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/jd2_all_macia" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- -->
    <View
        android:id="@+id/blackOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="invisible"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <!-- -->

    <ImageView
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="10dp"
        android:onClick="goBackHome"

        android:scaleType="fitXY"
        android:src="@drawable/app_home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>